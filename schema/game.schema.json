{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setup-app.local/schema/game.schema.json",
  "title": "Guía de preparación de un juego de mesa",
  "description": "Un fichero por juego. El motor no conoce ningún juego: todo lo específico vive aquí.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "players",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "sources": {
      "description": "Manuales de los que sale la información (trazabilidad).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "players": {
      "description": "Rango de jugadores. La variable 'players' queda disponible en las condiciones.",
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "default": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "options": {
      "description": "Preguntas que la app hace antes de generar la guía (expansiones, modo, dificultad...). Cada id es una variable usable en condiciones y textos.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "vars": {
      "description": "Valores derivados de las opciones. Se evalúan los casos en orden y gana el primero que cumpla 'when' (sin 'when' = caso por defecto).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "when": {
              "$ref": "#/$defs/condition"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "events": {
      "description": "Preparaciones que ocurren durante la partida (p. ej. al descubrir una especie). La app las muestra como botones aparte de la preparación inicial.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "description": "Agrupa eventos en la interfaz (p. ej. 'Descubrir especie')."
          },
          "when": {
            "$ref": "#/$defs/condition"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    },
    "reference": {
      "description": "Resumen para consultar durante la partida (turno, fin de ronda, fin de partida). Se muestra sin casillas en la pestaña «Turno». Si el juego tiene «rules», se usa eso en su lugar.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "when": {
            "$ref": "#/$defs/condition"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    },
    "scoring": {
      "description": "Hoja de puntuación final: la app pide los puntos de cada categoría a cada jugador y suma.",
      "type": "object",
      "required": [
        "categories"
      ],
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "help": {
                "type": "string"
              },
              "when": {
                "$ref": "#/$defs/condition"
              },
              "negative": {
                "type": "boolean",
                "description": "Se resta: el jugador anota el valor en positivo."
              },
              "inputs": {
                "description": "Calculadora: suma de dato × mult, dividido entre «divide» (hacia abajo) y multiplicado por los datos con factor.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "label": {
                      "type": "string"
                    },
                    "mult": {
                      "type": "number"
                    },
                    "factor": {
                      "type": "boolean",
                      "description": "Multiplica el resultado final (p. ej. número de cartas de un dios)."
                    }
                  }
                }
              },
              "divide": {
                "type": "integer",
                "minimum": 1,
                "description": "Divide el resultado y redondea hacia abajo."
              }
            }
          }
        },
        "tiebreak": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "rival": {
          "type": "object",
          "required": [
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "when": {
              "$ref": "#/$defs/condition"
            }
          },
          "description": "Añade una columna para el rival automático cuando se cumple la condición."
        }
      }
    },
    "rules": {
      "description": "Reglas para aprender a jugar, en capítulos. Si existe, sustituye a «reference» y la pestaña se llama «Reglas». Admite **negrita**.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "blocks"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "when": {
            "$ref": "#/$defs/condition"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "kind": {
                  "enum": [
                    "text",
                    "cards",
                    "table",
                    "steps",
                    "hand"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "when": {
                  "$ref": "#/$defs/condition"
                },
                "text": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "title": {
                        "type": "string"
                      },
                      "when": {
                        "$ref": "#/$defs/condition"
                      },
                      "phase": {
                        "$ref": "#/$defs/id"
                      },
                      "mode": {
                        "enum": [
                          "sim",
                          "turn",
                          "one"
                        ]
                      },
                      "crumb": {
                        "type": "string"
                      },
                      "tag": {
                        "type": "string"
                      },
                      "subtitle": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "meta": {
                        "type": "string"
                      },
                      "list": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "ordered": {
                        "type": "boolean"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "title",
                            "text"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "text": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "after": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "tip": {
                        "type": "string"
                      }
                    }
                  }
                },
                "phases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "label": {
                        "type": "string"
                      },
                      "sub": {
                        "type": "string"
                      }
                    }
                  }
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_]*$"
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "type": {
          "enum": [
            "boolean",
            "choice",
            "number"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string"
              },
              "when": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "when": {
          "description": "La pregunta solo se muestra si se cumple. Si no se muestra, vale su 'default'.",
          "$ref": "#/$defs/condition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "description": "Instrucción redactada con palabras propias. Admite {variable} para insertar opciones o vars.",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "who": {
          "description": "A quién afecta: mesa común, cada jugador o el rival automático.",
          "enum": [
            "table",
            "eachPlayer",
            "rival",
            "firstPlayer"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "qty": {
                "type": [
                  "integer",
                  "string"
                ],
                "description": "Número o {variable}."
              }
            }
          }
        },
        "tip": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        },
        "randomizer": {
          "$ref": "#/$defs/randomizer"
        },
        "link": {
          "type": "string",
          "format": "uri"
        },
        "substeps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "group": {
          "type": "boolean",
          "description": "Paso que agrupa tareas sencillas en sus subpasos. Si solo queda 1 subpaso visible, se muestra como paso normal; si no queda ninguno, se oculta."
        }
      }
    },
    "randomizer": {
      "description": "Ayuda que la app ejecuta con un botón.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "firstPlayer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "from",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "pick"
            },
            "from": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "fromWhen": {
              "description": "Elementos extra que solo entran en el sorteo si se cumple la condición.",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "when",
                  "items"
                ],
                "additionalProperties": false,
                "properties": {
                  "when": {
                    "$ref": "#/$defs/condition"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "count": {
              "type": [
                "integer",
                "string"
              ]
            },
            "hidden": {
              "type": "boolean",
              "description": "No mostrar el resultado hasta que se pida (p. ej. alienígenas boca abajo)."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "sides"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "dice"
            },
            "sides": {
              "type": "integer",
              "minimum": 2
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "condition": {
      "description": "Mini-lenguaje de condiciones. Las variables son 'players', los ids de options y los de vars.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "is"
          ],
          "additionalProperties": false,
          "properties": {
            "is": {
              "$ref": "#/$defs/id"
            }
          },
          "description": "La variable es verdadera (para booleanos)."
        },
        {
          "type": "object",
          "required": [
            "eq"
          ],
          "additionalProperties": false,
          "properties": {
            "eq": {
              "$ref": "#/$defs/comparison"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "in"
          ],
          "additionalProperties": false,
          "properties": {
            "in": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "array"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "required": [
            "gte"
          ],
          "additionalProperties": false,
          "properties": {
            "gte": {
              "$ref": "#/$defs/comparison"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "lte"
          ],
          "additionalProperties": false,
          "properties": {
            "lte": {
              "$ref": "#/$defs/comparison"
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}