{
  "schemaVersion": 1,
  "id": "puertoRico",
  "name": "Puerto Rico 1897",
  "publisher": "Ravensburger / alea",
  "sources": [
    {
      "title": "Reglamento Puerto Rico 1897 Special Edition",
      "file": "Puerto_rico_edicion_especial.pdf"
    },
    {
      "title": "Reglamento Puerto Rico 1897",
      "file": "Puerto_rico.pdf"
    }
  ],
  "players": {
    "min": 1,
    "max": 5,
    "default": 4
  },
  "options": [
    {
      "id": "edition",
      "label": "¿Qué edición tenéis?",
      "type": "choice",
      "default": "special",
      "help": "Las reglas son las mismas; cambian algunos componentes (bandejas, bolsa de plantaciones) y la especial trae más expansiones y el Puertoma.",
      "choices": [
        {
          "value": "special",
          "label": "Special Edition"
        },
        {
          "value": "standard",
          "label": "Estándar",
          "when": {
            "gte": [
              "players",
              2
            ]
          }
        }
      ]
    },
    {
      "id": "puertoma2p",
      "label": "¿Jugáis los 2 contra un Puertoma (jugador virtual)?",
      "type": "boolean",
      "default": false,
      "when": {
        "all": [
          {
            "eq": [
              "players",
              2
            ]
          },
          {
            "eq": [
              "edition",
              "special"
            ]
          }
        ]
      },
      "help": "Alternativa más interactiva a las reglas clásicas de 2 jugadores: se prepara como una partida de 3."
    },
    {
      "id": "botLevel",
      "label": "Dificultad del Puertoma",
      "type": "choice",
      "default": "normal",
      "when": {
        "any": [
          {
            "eq": [
              "players",
              1
            ]
          },
          {
            "is": "puertoma2p"
          }
        ]
      },
      "choices": [
        {
          "value": "easy",
          "label": "Fácil"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "hard",
          "label": "Difícil"
        }
      ]
    },
    {
      "id": "expNewBuildings",
      "label": "¿1ª expansión: Los nuevos edificios?",
      "type": "boolean",
      "default": false
    },
    {
      "id": "expBurghers",
      "label": "¿2ª expansión: Los burgueses?",
      "type": "boolean",
      "default": false
    },
    {
      "id": "expSmuggler",
      "label": "¿3ª expansión: El contrabandista?",
      "type": "boolean",
      "default": false
    },
    {
      "id": "expFestival",
      "label": "¿4ª expansión: El festival?",
      "type": "boolean",
      "default": false
    },
    {
      "id": "expFestivalCards",
      "label": "¿5ª expansión: Cartas de festival?",
      "type": "boolean",
      "default": false,
      "when": {
        "all": [
          {
            "eq": [
              "edition",
              "special"
            ]
          },
          {
            "is": "expFestival"
          }
        ]
      }
    },
    {
      "id": "expAchievements",
      "label": "¿6ª expansión: Logros?",
      "type": "boolean",
      "default": false,
      "when": {
        "eq": [
          "edition",
          "special"
        ]
      }
    },
    {
      "id": "achDraft",
      "label": "¿Logros con selección (draft)?",
      "type": "boolean",
      "default": false,
      "when": {
        "is": "expAchievements"
      },
      "help": "Recomendado para jugadores con experiencia."
    }
  ],
