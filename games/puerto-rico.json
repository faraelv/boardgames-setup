{
  "schemaVersion": 1,
  "id": "puertoRico",
  "name": "Puerto Rico 1897",
  "publisher": "Ravensburger / alea",
  "sources": [
    {
      "title": "Reglamento Puerto Rico 1897",
      "file": "Puerto_rico.pdf"
    }
  ],
  "players": {
    "min": 2,
    "max": 5,
    "default": 4
  },
  "options": [
    {
      "id": "expNewBuildings",
      "label": "¿1ª expansión: Los nuevos edificios?",
      "type": "boolean",
      "default": false
    },
    {
      "id": "expBurghers",
      "label": "¿2ª expansión: Los burgueses?",
      "type": "boolean",
      "default": false
    },
    {
      "id": "expSmuggler",
      "label": "¿3ª expansión: El contrabandista?",
      "type": "boolean",
      "default": false
    },
    {
      "id": "expFestival",
      "label": "¿4ª expansión: El festival?",
      "type": "boolean",
      "default": false
    }
  ],
  "vars": {
    "coins": [
      {
        "when": {
          "eq": [
            "players",
            2
          ]
        },
        "value": 3
      },
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": 2
      },
      {
        "when": {
          "eq": [
            "players",
            4
          ]
        },
        "value": 3
      },
      {
        "value": 4
      }
    ],
    "vp": [
      {
        "when": {
          "eq": [
            "players",
            2
          ]
        },
        "value": 65
      },
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": 75
      },
      {
        "when": {
          "eq": [
            "players",
            4
          ]
        },
        "value": 100
      },
      {
        "value": 126
      }
    ],
    "workers": [
      {
        "when": {
          "eq": [
            "players",
            2
          ]
        },
        "value": 40
      },
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": 55
      },
      {
        "when": {
          "eq": [
            "players",
            4
          ]
        },
        "value": 75
      },
      {
        "value": 95
      }
    ],
    "ships": [
      {
        "when": {
          "eq": [
            "players",
            2
          ]
        },
        "value": "4 y 6"
      },
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": "4, 5 y 6"
      },
      {
        "when": {
          "eq": [
            "players",
            4
          ]
        },
        "value": "5, 6 y 7"
      },
      {
        "value": "6, 7 y 8"
      }
    ],
    "roles": [
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": "todas menos los dos Aventureros (6)"
      },
      {
        "when": {
          "eq": [
            "players",
            5
          ]
        },
        "value": "las 8"
      },
      {
        "value": "todas menos un Aventurero (7)"
      }
    ],
    "startPlantations": [
      {
        "when": {
          "eq": [
            "players",
            2
          ]
        },
        "value": "el primero (Gobernador) fruta; el segundo, maíz"
      },
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": "el primero (Gobernador) y el segundo, fruta; el tercero, maíz"
      },
      {
        "when": {
          "eq": [
            "players",
            4
          ]
        },
        "value": "el primero (Gobernador) y el segundo, fruta; el tercero y el cuarto, maíz"
      },
      {
        "value": "el primero (Gobernador), el segundo y el tercero, fruta; el cuarto y el quinto, maíz"
      }
    ],
    "faceUpPlantations": [
      {
        "when": {
          "eq": [
            "players",
            2
          ]
        },
        "value": 3
      },
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": 4
      },
      {
        "when": {
          "eq": [
            "players",
            4
          ]
        },
        "value": 5
      },
      {
        "value": 6
      }
    ]
  },
  "sections": [
    {
      "id": "board",
      "title": "Tablero central",
      "steps": [
        {
          "id": "bankVp",
          "who": "table",
          "text": "Banca, puntos y canteras:",
          "group": true,
          "substeps": [
            {
              "id": "central",
              "text": "Coloca el tablero central con la banca en el centro y deja las 51 monedas en la banca."
            },
            {
              "id": "vp",
              "text": "Prepara {vp} puntos de victoria en 2 montones."
            },
            {
              "id": "quarries",
              "text": "Deja las 8 losetas de cantera boca arriba."
            }
          ]
        },
        {
          "id": "allBuildings",
          "who": "table",
          "text": "Edificios:",
          "group": true,
          "substeps": [
            {
              "id": "buildings",
              "text": "Pon todos los edificios del juego base en el tablero central, según indica el tablero.",
              "when": {
                "all": [
                  {
                    "not": {
                      "is": "expNewBuildings"
                    }
                  },
                  {
                    "gte": [
                      "players",
                      3
                    ]
                  }
                ]
              }
            },
            {
              "id": "buildings2p",
              "text": "Con 2 jugadores, pon en el tablero central 1 de cada edificio beis y 2 de cada uno de los 6 edificios productores.",
              "when": {
                "all": [
                  {
                    "not": {
                      "is": "expNewBuildings"
                    }
                  },
                  {
                    "eq": [
                      "players",
                      2
                    ]
                  }
                ]
              }
            },
            {
              "id": "newBuildings",
              "text": "Pon los edificios productores en el tablero como siempre. Extiende al lado los 55 edificios beis (antiguos y nuevos). Empezando por el jugador inicial, cada uno elige uno y lo coloca en una casilla libre de su coste, hasta cubrir las 12 + 5 casillas beis. El resto, a la caja. En los costes 2, 5 y 8 se pueden elegir dos cualesquiera de los cuatro disponibles.",
              "when": {
                "is": "expNewBuildings"
              }
            },
            {
              "id": "burghersBuildings",
              "text": "Añade los edificios de los burgueses al tablero central según su coste (filas 1 a 4) y deja el dinero junto a la banca.",
              "when": {
                "is": "expBurghers"
              }
            }
          ]
        },
        {
          "id": "allPlantations",
          "who": "table",
          "text": "Plantaciones:",
          "group": true,
          "substeps": [
            {
              "id": "plantations2p",
              "text": "Con 2 jugadores, retira del juego 3 losetas de cada tipo (maíz, fruta, azúcar, tabaco, café y cantera).",
              "when": {
                "eq": [
                  "players",
                  2
                ]
              }
            },
            {
              "id": "plantations",
              "text": "Mezcla boca abajo las losetas de plantación restantes en pilas y revela {faceUpPlantations} junto a las canteras (una más que jugadores)."
            }
          ]
        },
        {
          "id": "rolesShips",
          "who": "table",
          "text": "Roles y barcos:",
          "group": true,
          "substeps": [
            {
              "id": "roles",
              "text": "Tarjetas de rol: usa {roles}."
            },
            {
              "id": "smugglerRole",
              "text": "Añade la tarjeta de rol Contrabandista y deja a mano los carteles de contrabandista.",
              "when": {
                "is": "expSmuggler"
              }
            },
            {
              "id": "ships",
              "text": "Barcos cargueros: los de {ships} casillas."
            }
          ]
        },
        {
          "id": "barrelsWorkers",
          "who": "table",
          "text": "Barriles y trabajadores:",
          "group": true,
          "substeps": [
            {
              "id": "barrels",
              "text": "Deja los barriles de mercancía en 5 montones y la Casa de Comercio junto al tablero."
            },
            {
              "id": "barrels2p",
              "text": "Con 2 jugadores, retira 2 barriles de cada tipo.",
              "when": {
                "eq": [
                  "players",
                  2
                ]
              }
            },
            {
              "id": "workers",
              "text": "Pon {players} trabajadores en el Registro de Empleo y deja {workers} como reserva.",
              "when": {
                "not": {
                  "is": "expBurghers"
                }
              }
            },
            {
              "id": "workersBurghers",
              "text": "Deja los trabajadores y los 20 burgueses como reserva (no hace falta contarlos). Pon un burgués en el Registro de Empleo en lugar de un trabajador.",
              "when": {
                "is": "expBurghers"
              }
            }
          ]
        },
        {
          "id": "festival",
          "who": "table",
          "when": {
            "is": "expFestival"
          },
          "text": "Coloca la tabla Festival y sortea sus tres objetivos.",
          "substeps": [
            {
              "id": "fPlant",
              "text": "Plantaciones: mezcla una de cada tipo de cultivo y pon una al azar; las otras vuelven a la reserva."
            },
            {
              "id": "fGoods",
              "text": "Mercancías: mezcla 3 barriles de cada tipo y pon 3 al azar (pueden repetirse)."
            },
            {
              "id": "fBuild",
              "text": "Edificios: mezcla un edificio de cada tipo de la tercera fila y pon uno al azar. Si coincide con el productor de la plantación elegida, repite. Con 2 jugadores, rellena el hueco en el tablero con su gemelo."
            }
          ]
        }
      ]
    },
    {
      "id": "players",
      "title": "Jugadores",
      "steps": [
        {
          "id": "boards",
          "who": "eachPlayer",
          "text": "Cada jugador coge un tablero individual y {coins} monedas, que deja a la vista sobre su retrato."
        },
        {
          "id": "governor",
          "who": "table",
          "text": "Sortea el jugador inicial: recibe la tarjeta de Gobernador.",
          "randomizer": {
            "type": "firstPlayer"
          }
        },
        {
          "id": "startPlant",
          "who": "eachPlayer",
          "text": "Plantación inicial, en orden de turno: {startPlantations}. Cada uno la pone boca arriba en una casilla de cultivo de su isla."
        },
        {
          "id": "rounds2p",
          "who": "table",
          "when": {
            "eq": [
              "players",
              2
            ]
          },
          "text": "Con 2 jugadores, en cada ronda se eligen 6 de los 7 roles (3 cada uno); el séptimo recibe 1 moneda y después cambia el Gobernador."
        }
      ]
    }
  ],
  "reference": [
    {
      "id": "round",
      "title": "Ronda",
      "items": [
        {
          "id": "pick",
          "text": "Empezando por el Gobernador, cada jugador elige 1 rol: él tiene el privilegio y todos (en orden, desde él) hacen la acción."
        },
        {
          "id": "roles",
          "text": "Plantador (+cantera) · Reclutador (+1 trabajador) · Constructor (−1 al coste) · Productor (+1 barril) · Mercader (+1 moneda) · Capitán (+1 PV) · Aventurero (1 moneda, solo él)."
        },
        {
          "id": "coins",
          "text": "Fin de ronda: los roles no elegidos reciben 1 moneda y el Gobernador pasa a la izquierda."
        }
      ]
    },
    {
      "id": "end",
      "title": "Fin de la partida",
      "items": [
        {
          "id": "end",
          "text": "Al final de la ronda en que no se pueden reponer los trabajadores del Registro, alguien construye su 12ª casilla o se agotan las fichas de PV."
        }
      ]
    }
  ],
  "scoring": {
    "categories": [
      {
        "id": "chips",
        "label": "Fichas de puntos de victoria"
      },
      {
        "id": "buildings",
        "label": "Edificios",
        "help": "Número blanco de cada edificio, ocupado o no."
      },
      {
        "id": "large",
        "label": "Extra de edificios grandes",
        "help": "Solo si están ocupados."
      },
      {
        "id": "burghers",
        "label": "Burgueses",
        "help": "1 por burgués.",
        "when": {
          "is": "expBurghers"
        }
      }
    ],
    "tiebreak": "Gana quien tenga más monedas y barriles (1 barril = 1 moneda)."
  }
}
