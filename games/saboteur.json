{
  "schemaVersion": 1,
  "id": "saboteur",
  "name": "Saboteur",
  "publisher": "Amigo",
  "sources": [
    {
      "title": "Reglamento Saboteur",
      "file": "Saboteur.pdf"
    }
  ],
  "players": {
    "min": 3,
    "max": 10,
    "default": 5
  },
  "vars": {
    "saboteurs": [
      {
        "when": {
          "lte": [
            "players",
            4
          ]
        },
        "value": 1
      },
      {
        "when": {
          "lte": [
            "players",
            6
          ]
        },
        "value": 2
      },
      {
        "when": {
          "lte": [
            "players",
            9
          ]
        },
        "value": 3
      },
      {
        "value": 4
      }
    ],
    "miners": [
      {
        "when": {
          "eq": [
            "players",
            3
          ]
        },
        "value": 3
      },
      {
        "when": {
          "eq": [
            "players",
            4
          ]
        },
        "value": 4
      },
      {
        "when": {
          "eq": [
