        },
        "value": 5
      },
      {
        "when": {
          "eq": [
            "players",
            8
          ]
        },
        "value": 6
      },
      {
        "value": 7
      }
    ],
    "handSize": [
      {
        "when": {
          "lte": [
            "players",
